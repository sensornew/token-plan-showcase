# ===== 服务器配置 =====
PORT=3210
# 生产环境需设置为实际域名，如 https://tokenplan.dev
# 邮件中的退订链接会使用此地址
BASE_URL=http://localhost:3210
# 管理员 API Key，保护内部端点（price-change/test-email/import）
# 不配置则这些端点拒绝所有请求
ADMIN_API_KEY=

# ===== 邮件服务配置（二选一）=====

# 方案 A: SMTP（支持 Gmail / QQ邮箱 / 企业邮箱等）
# Gmail 示例: smtp.gmail.com / 465 / 你的 Gmail 地址 / 应用专用密码
# QQ邮箱示例: smtp.qq.com / 465 / QQ邮箱地址 / 授权码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@qq.com
SMTP_PASS=your_smtp_authorization_code

# 方案 B: Resend API（需 resend.com 注册获取 API Key）
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=onboarding@resend.dev

# ===== 邮件发件人显示名 =====
MAIL_FROM_NAME=TokenPlan 价格预警
MAIL_FROM_ADDRESS=your_email@qq.com

# ===== 前端地址（CORS 白名单）=====
FRONTEND_ORIGIN=http://localhost:3000

# ===== 价格监控计划（cron 表达式，留空则用默认每日 9:00）=====
MONITOR_CRON=0 9 * * *
